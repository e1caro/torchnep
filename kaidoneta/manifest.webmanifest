{
  "id": "./index.html",
  "name": "Kaidoneta",
  "short_name": "Kaidoneta",
  "lang": "es",
  "description": "La app de la tripulación para el One Piece Card Game en el Regional de Bristol: registra rondas, recompensas, el Tablón de recompensas, el meta, insignias y un temporizador. Funciona sin conexión.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12081f",
  "theme_color": "#12081f",
  "categories": ["games", "entertainment", "utilities"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Registrar ronda", "short_name": "Registrar", "url": "./index.html#/home", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tablón de recompensas", "short_name": "Recompensas", "url": "./index.html#/board", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
