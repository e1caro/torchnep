{
  "id": "./index.html",
  "name": "Kaidoneta",
  "short_name": "Kaidoneta",
  "description": "The crew's One Piece Card Game tracker for the Bristol Regional: log rounds, bounties, a Bounty Board ranking, the meta, badges, a round timer. Works offline.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#12081f",
